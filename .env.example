# ==========================================
# CONFIGURACIÓN GENERAL
# ==========================================
# Cambia a 'false' cuando conectes tus cuentas reales en Supabase/APIs
NEXT_PUBLIC_USE_MOCK_DATA=true

# ==========================================
# SUPABASE (Base de Datos en la Nube)
# ==========================================
# Obtenidos en https://supabase.com -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui

# ==========================================
# YOUTUBE DATA API v3 (Google Cloud Console)
# ==========================================
# https://console.cloud.google.com -> Habilitar YouTube Data API v3
YOUTUBE_API_KEY=tu-api-key-de-google-aqui
YOUTUBE_CLIENT_ID=tu-oauth-client-id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=tu-oauth-client-secret

# ==========================================
# TIKTOK CONFIGURACIÓN (Dual-Mode)
# ==========================================
# MODO A (Recomendado actual sin dev account):
# Lista de nombres de usuario de TikTok que monitorearás (separados por coma)
TIKTOK_MONITORED_HANDLES=carlos.oficial,carlostechhacks

# MODO B (API Oficial de Desarrollador - Opcional a futuro):
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
